{
  "name": "flenova-frontend",
  "version": "1.0.0",
  "description": "Flenova Frontend - TMS Complet",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./css/tailwind.css --watch",
    "version:assets": "npm run build:css && node ./scripts/version-assets.js",
    "check:assets": "node ./scripts/version-assets.js --check",
    "postinstall": "npm run vendor",
    "vendor": "node ./scripts/copy-vendor.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fortawesome/fontawesome-free": "6.4.0",
    "chart.js": "4.5.1",
    "html2pdf.js": "0.14.0",
    "maplibre-gl": "6.13.0",
    "tailwindcss": "^3.4.1"
  }
}
